generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* =========================
   ENUMS
========================= */

enum TaskPriority {
  low
  medium
  high
  urgent
}

enum TaskColumn {
  backlog
  todo
  doing
  done
}

enum TaskLinkType {
  budget
  receipt
  delivery_note
}

enum RendicionStatus {
  draft   // se está armando, todavía editable
  closed  // cerrada: valores fijos, ya se pagó/exportó
}

enum WorkOrderPriority {
  low
  medium
  high
  urgent
}

enum WorkOrderStatus {
  pending
  in_progress
  paused
  completed
  cancelled
  voided
}

enum DeliveryNoteStatus {
  active
  voided
}

enum PaymentMethod {
  efectivo
  transferencia
  cheque
  tarjeta
  mercado_pago
  otro
}

enum ReceiptStatus {
  active
  voided
}

enum ProductCategory {
  biodigesters
  grease_traps
  maintenance
  other
}

enum BudgetStatus {
  draft
  sent
  approved
  rejected
  completed

  // Legacy state kept for backward compatibility; new updates should use current statuses.
  expired
}

enum ClientType {
  home
  home_modular
  cabin
  hall
  sanitary
  company
}

enum StockMovementType {
  in
  out
  adjust
}

enum UserRole {
  owner
  admin
  seller
  installer
  viewer
}

/* =========================
   TENANT
========================= */

model Tenant {
  id        String @id @default(uuid())

  name      String
  slug      String @unique

  email String?
  phone String?
  address String?
  website String?
  description String?

  logoUrl        String?
  faviconUrl     String?
  watermarkUrl   String?
  sidebarIconUrl String?
  primaryColor   String?
  secondaryColor String?
  accentColor    String?
  watermarkOpacity Float? @default(0.06)
  logoSize         Int?   @default(100)
  showPageNumbers  Boolean? @default(true)
  showWebsiteInPdf Boolean? @default(true)
  showFooterBranding Boolean? @default(false)
  preferredTheme  String? @default("system")
  pdfTemplate     String? @default("clasico") // 👈 nuevo — "clasico" | "contraste" | "cantonera" | "directa" (selector de diseño PDF, PRO)
  pdfTemplateDark Boolean? @default(false) // 👈 nuevo — toggle fondo claro/oscuro, solo lo usa la plantilla "directa"

  customSellerLabel    String? @default("Vendedor")
  customInstallerLabel String? @default("Instalador")

  plan     String? @default("free")
  maxUsers Int?    @default(5)
  trialEndsAt DateTime?
  mpSubscriptionId String?
  proBillingInterval String? // 👈 nuevo — "monthly" | "annual", solo informativo/UI

  active Boolean @default(true)
  
  budgetSequence Int @default(1)

  rendiciones    Rendicion[]

  users          User[]
  clients        Client[]
  budgets        Budget[]
  sellers        Seller[]
  installers     Installer[]
  products       ProductService[]
  productCategories TenantProductCategory[]
  stockMovements StockMovement[]
  serviceProductIds String[] @default([]) // 👈 nuevo — organización manual y visual, no forma parte del modelo de negocio real

  features Json? // { "calculator": bool, "commissions": bool, "vouchers": bool, "dashboardMetrics": bool, "stockAnalytics": bool }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  currency String @default("ARS") 
  cuit         String?  
  condicionIva String?  
  receiptSequence Int @default(1) 
  receiptSequenceStandalone Int @default(1) // 👈 nuevo — serie separada para recibos sin presupuesto
  deliveryNoteSequence Int @default(1) // 👈 nuevo
  receipts     Receipt[] 
  deliveryNotes DeliveryNote[] // 👈 nuevo

  workOrderSequence Int @default(1) // 👈 nuevo
  workOrders WorkOrder[] // 👈 nuevo

  tasks Task[]
  kioskBoards KioskBoard[] // 👈 nuevo — falta esto, es el lado inverso de KioskBoard.tenant

  referralCodeId String?
  referralCode   ResellerCode? @relation(fields: [referralCodeId], references: [id])

  conditionsPdfUrl  String? // data URI base64 del PDF de condiciones
  conditionsPdfName String? // nombre original, para mostrarlo en la UI

  expenses          Expense[]               // 👈 nuevo
  expenseCategories TenantExpenseCategory[]  // 👈 nuevo
}

/* =========================
   USERS
========================= */

model User {
  id        String   @id @default(uuid())

  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name      String
  email     String   @unique
  password  String?

  emailVerified DateTime?
  image         String?

  role      UserRole @default(viewer)
  active    Boolean @default(true)
  hasSeenOnboarding Boolean @default(false)   

  accounts  Account[]
  sessions  Session[]
  seller    Seller?
  installer Installer?

  receipts Receipt[] 
  deliveryNotes DeliveryNote[] // 👈 nuevo
  workOrderHelperOf WorkOrderHelper[] @relation("WorkOrderHelpers") // 👈 nuevo

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workOrdersAssigned WorkOrder[] @relation("AssignedTechnician") // 👈 nuevo
  workOrdersRegistered WorkOrder[] @relation("RegisteredBy") // 👈 nuevo

  tasksCreated Task[] // 👈 nuevo

  expensesRegistered Expense[] // 👈 nuevo


  @@index([tenantId])
}

/* =========================
   NEXTAUTH
========================= */

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/* =========================
   CLIENTS
========================= */

model Client {
  id        String   @id @default(uuid())

  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Identidad
  name      String
  lastName  String?
  company   String?
  dni       String?
  cuit      String?

  // Contacto
  email     String?
  phone     String
  whatsappNumber String? // 👈 nuevo — normalizado, solo dígitos, listo para wa.me

  // Dirección
  address   String

  // Ubicación
  latitude  Float?
  longitude Float?
  city      String?
  province  String?

  // Uso
  type            ClientType?
  peopleCount     Int?
  usageFrequency  String?

  // Comercial
  status           String   @default("nuevo")
  notes            String   @default("")
  lastContactAt    DateTime?
  assignedSellerId String?
  locationUrl      String?

  // Relaciones
  budgets   Budget[]
  receipts  Receipt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

/* =========================
   PRODUCTS / SERVICES
========================= */

model ProductService {
  id          String           @id @default(uuid())

  tenantId    String
  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  description String
  category    ProductCategory
  customCategoryId String?
  customCategory   TenantProductCategory? @relation(fields: [customCategoryId], references: [id])


  price       Float
  cost        Float?
  unit        String

  active      Boolean @default(true)

  stock       Float @default(0) // 👈 antes: Int
  variants    ProductVariant[]

  items            BudgetItem[]
  stockMovements   StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  currency String @default("ARS") // 👈 moneda en la que está cargado el precio
  workOrderMaterials WorkOrderMaterial[] // 👈 nuevo

  @@index([tenantId])
}

model TenantProductCategory {
  id        String   @id @default(uuid())

  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name      String   // "Lonas"
  slug      String   // "lonas"

  createdAt DateTime @default(now())

  products  ProductService[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

/* =========================
   BUDGETS
========================= */

model Budget {
  id        String @id @default(uuid())

  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  budgetNumber Int?

  clientId  String
  client    Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  items     BudgetItem[]
  history   BudgetStatusHistory[]

  status    BudgetStatus @default(draft)

  notes     String @default("")

  active    Boolean @default(true)

  // Vendedor
  sellerId  String?
  seller    Seller? @relation(fields: [sellerId], references: [id], onDelete: SetNull)

  // Instalador
  installerId String?
  installer   Installer? @relation(fields: [installerId], references: [id], onDelete: SetNull)

  // Instalación
  installationResponsible String?
  installerReference      String?

  // Información adicional
  details Json?

  // Montos
  subtotal     Float
  discount     Float @default(0)
  tax          Float @default(0)
  shippingCost Float?
  total        Float

  // Comerciales
  paymentTerms String?
  validUntil   DateTime?

  rendiciones RendicionBudget[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  currency String @default("ARS") 
  revisionNumber Int @default(0) 

  receipts Receipt[] 
  deliveryNotes DeliveryNote[] // 👈 nuevo
  workOrders WorkOrder[] // 👈 nuevo

  attachConditionsPdf Boolean @default(true) // 👈 nuevo — se guarda por presupuesto, no solo en el form

  expenses Expense[] // 👈 nuevo
   
  @@index([tenantId])
  @@index([clientId])
}

/* =========================
   INSTALLERS
========================= */

model Installer {
  id        String @id @default(uuid())

  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name      String
  lastName  String

  phone     String
  email     String?

  city      String?

  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  budgets   Budget[]

  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

/* =========================
   SELLERS
========================= */

model Seller {
  id        String @id @default(uuid())

  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name      String
  lastName  String

  dni       String?
  email     String?
  phone     String?

  address   String?
  city      String?
  province  String?

  sector    String?

  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  budgets   Budget[]

  active    Boolean @default(true)

  rendicionShares RendicionSellerShare[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

/* =========================
   BUDGET ITEMS
========================= */

model BudgetItem {
  id               String @id @default(uuid())

  budgetId         String
  budget           Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  // 🌟 1. Lo hacemos opcional con "?" y le agregamos onDelete: SetNull
  productServiceId String?
  productService   ProductService? @relation(fields: [productServiceId], references: [id], onDelete: SetNull)

  // 🌟 2. Campo para cuando escriben un producto/servicio a medida que no existe en stock
  customName       String?

  quantity         Float

  unitPrice        Float

  discount         Float @default(0)

  subtotal         Float?

  cost             Float?

  productVariantId  String?
  productVariant    ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  widthCm          Float?
  heightCm         Float?
  hours            Float?
  calculatedM2     Float?
  depthCm          Float?
  direct           Float?
}

/* =========================
   BUDGET HISTORY
========================= */

model BudgetStatusHistory {
  id        String @id @default(uuid())

  budgetId  String
  budget    Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  from      BudgetStatus
  to        BudgetStatus

  changedAt DateTime @default(now())

  user      String?
}

/* =========================
   STOCK MOVEMENTS
========================= */

model StockMovement {
  id        String @id @default(cuid())

  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  productServiceId String
  productService   ProductService @relation(fields: [productServiceId], references: [id])

  delta     Float

  type      StockMovementType

  reason    String?

  createdAt DateTime @default(now())

  productVariantId String?
  productVariant    ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)


  @@index([tenantId])
}

/* =========================
   RECEIPT
========================= */


model Receipt {
  id             String   @id @default(uuid())

  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  budgetId       String?  // 👈 antes: String (obligatorio)
  budget         Budget?  @relation(fields: [budgetId], references: [id], onDelete: Cascade) // 👈 antes: Budget (obligatorio)
  
  clientId       String?  // 👈 nuevo — solo se usa cuando NO hay budgetId
  client         Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull) // 👈 nuevo

  
  receiptNumber  Int
  isStandalone   Boolean  @default(false) // 👈 nuevo — distingue la serie, más explícito que "budgetId es null"


  issueDate      DateTime @default(now())
  issuePlace     String?

  concept        String
  amount         Float
  currency       String

  paymentMethod    PaymentMethod
  paymentReference String?

  pendingBalance Float?

  notes          String?
  branch         String?
  cashRegister   String?

  registeredByUserId String?
  registeredByUser   User?   @relation(fields: [registeredByUserId], references: [id], onDelete: SetNull)

  status         ReceiptStatus @default(active)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([budgetId])
  @@index([clientId]) // 👈 nuevo
}


/* =========================
   DELIVERY NOTES
========================= */


model DeliveryNote {
  id               String   @id @default(uuid())

  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  budgetId         String
  budget           Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  deliveryNumber   Int

  issueDate        DateTime @default(now())

  // Transporte (todo opcional — no siempre hay transportista tercero)
  vehicle          String?
  driverName       String?
  licensePlate     String?
  carrierCompany   String?

  // Recepción
  receivedByName   String?
  receivedByDni    String?
  receivedAt       DateTime?

  notes            String?

  registeredByUserId String?
  registeredByUser   User?   @relation(fields: [registeredByUserId], references: [id], onDelete: SetNull)

  status           DeliveryNoteStatus @default(active)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([budgetId])
}

/* =========================
   WORKORDERS
========================= */


model WorkOrder {
  id             String   @id @default(uuid())

  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  budgetId       String
  budget         Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  workOrderNumber Int

  status         WorkOrderStatus @default(pending)

  pauseReason    String?  // 👈 nuevo — motivo de la pausa (ej: "se frenó por lluvia")

  priority           WorkOrderPriority @default(medium) // 👈 nuevo
  scheduledTimeFrom  String?  // 👈 nuevo, ej "08:00"
  scheduledTimeTo    String?  // 👈 nuevo, ej "12:00"
  branch             String?  // 👈 nuevo, sucursal (mismo patrón que Receipt)

  materials WorkOrderMaterial[] // 👈 nuevo
  tasks     WorkOrderTask[]     // 👈 nuevo
  tools     WorkOrderTool[]     // 👈 nuevo
  helpers   WorkOrderHelper[]   // 👈 nuevo

  title          String?
  description    String?

  assignedToUserId String?
  assignedToUser   User?  @relation("AssignedTechnician", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  scheduledDate  DateTime?
  startedAt      DateTime?
  completedAt    DateTime?

  locationUrl        String?

  estimatedHours Float?
  actualHours    Float?

  notes          String?

  registeredByUserId String?
  registeredByUser   User?  @relation("RegisteredBy", fields: [registeredByUserId], references: [id], onDelete: SetNull)

  checklist      WorkOrderChecklistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([budgetId])
  @@index([assignedToUserId])
}


model WorkOrderChecklistItem {
  id          String   @id @default(uuid())

  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  label       String
  completed   Boolean  @default(false)
  completedAt DateTime?
  order       Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workOrderId])
}


model WorkOrderMaterial {
  id          String   @id @default(uuid())

  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  productServiceId String?
  productService   ProductService? @relation(fields: [productServiceId], references: [id], onDelete: SetNull)

  customName  String?
  quantity    Float
  unit        String?
  order       Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workOrderId])
}


model WorkOrderTask {
  id          String   @id @default(uuid())

  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  label       String
  order       Int @default(0)

  createdAt DateTime @default(now())

  @@index([workOrderId])
}


model WorkOrderTool {
  id          String   @id @default(uuid())

  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  label       String
  checked     Boolean @default(false)
  order       Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workOrderId])
}


model WorkOrderHelper {
  id          String   @id @default(uuid())

  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  userId      String
  user        User @relation("WorkOrderHelpers", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([workOrderId, userId])
  @@index([workOrderId])
  @@index([userId])
}

/* =========================
   RENDICIONES
========================= */


model Rendicion {
  id             String   @id @default(uuid())

  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  periodStart    DateTime
  periodEnd      DateTime

  status         RendicionStatus @default(draft)

  // Totales cacheados al momento de generar/cerrar (evita recalcular
  // y garantiza que lo exportado no cambie si después editan un presupuesto viejo)
  presupuestosCompletados Int
  totalFacturado Float
  totalCosto     Float
  totalGanancia  Float
  margenPromedio Float

  shares         RendicionSellerShare[]
  budgets        RendicionBudget[]

  closedAt       DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  asignaciones RendicionAsignacion[]

  totalGastosGenerales Float @default(0) // 👈 nuevo

  @@index([tenantId])
  @@index([tenantId, periodStart, periodEnd])
}

model RendicionSellerShare {
  id             String    @id @default(uuid())

  rendicionId    String
  rendicion      Rendicion @relation(fields: [rendicionId], references: [id], onDelete: Cascade)

  sellerId       String
  seller         Seller    @relation(fields: [sellerId], references: [id])

  // Métricas del vendedor en el período (cacheadas junto con el resto)
  presupuestosCompletados Int
  totalFacturado Float
  ganancia       Float
  margenPromedio Float

  // Distribución editable
  percentage     Float     // % asignado, editable por el usuario
  gananciaAPagar Float     // = totalGanancia (de Rendicion) * percentage / 100

  isDefault      Boolean   @default(true) // false si el usuario tocó el % a mano
                                           // (así "Resetear" sabe si tiene algo que resetear)

  @@unique([rendicionId, sellerId])
  @@index([sellerId])
}

model RendicionBudget {
  id          String    @id @default(uuid())

  rendicionId String
  rendicion   Rendicion @relation(fields: [rendicionId], references: [id], onDelete: Cascade)

  budgetId    String
  budget      Budget    @relation(fields: [budgetId], references: [id])

  @@unique([rendicionId, budgetId])
  @@index([budgetId])
}

model RendicionAsignacion {
  id           String   @id @default(uuid())
  rendicionId  String
  budgetId     String
  sellerId     String
  percentage   Float
  monto        Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rendicion    Rendicion @relation(fields: [rendicionId], references: [id], onDelete: Cascade)

  @@unique([rendicionId, budgetId, sellerId]) // 👈 clave — permite "reemplazar" en vez de "sumar"
}

/*VARIANTES DE PRODUCTOS ---------------------------- */

model ProductVariant {
  id               String  @id @default(uuid())

  productServiceId String
  productService   ProductService @relation(fields: [productServiceId], references: [id], onDelete: Cascade)

  label            String  // "Rojo", "Mate", "Talle L"... genérico
  stock            Float @default(0) // 👈 antes: Int
  active           Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  budgetItems BudgetItem[]
  stockMovements StockMovement[]

  @@unique([productServiceId, label])
  @@index([productServiceId])
}

/* =========================
   TASK
========================= */


model Task {
  id        String     @id @default(uuid())

  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  title       String
  description String?
  column      TaskColumn @default(backlog)
  order       Int        @default(0)

  linkType  TaskLinkType?
  linkId    String?

  createdByUserId String?
  createdByUser   User? @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  kioskBoardId String?
  kioskBoard   KioskBoard? @relation(fields: [kioskBoardId], references: [id])
  priority     TaskPriority? @default(medium) // 👈 nuevo, si no existe ya — para el borde rojo


  @@index([tenantId])
  @@index([tenantId, column])
}

/* =========================
   RECELLERS
========================= */

model ResellerCode {
  id              String   @id @default(uuid())
  code            String   @unique // "GUALEGUAYCHU10"
  resellerName    String
  resellerContact String?
  discountPercent Int      // 10, 40, etc. — debe tener su par de planes MP creado
  active          Boolean  @default(true)

  tenants         Tenant[]

  createdAt       DateTime @default(now())
}

model KioskBoard {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String   // "Placard Sr. Gómez", "Reunión", "Producción"...
  order     Int      @default(0) // para el orden de las solapas
  priority  TaskPriority @default(medium)
  createdAt DateTime @default(now())

  tasks Task[]
}

/* =========================
   EXPENSES
========================= */

model TenantExpenseCategory {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String   // "Alquiler", "Insumos", "Sueldos"...
  slug      String
  createdAt DateTime @default(now())

  expenses  Expense[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model Expense {
  id          String   @id @default(uuid())

  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  categoryId  String?
  category    TenantExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // 👇 opcional — si viene cargado, es un gasto asociado a un trabajo puntual
  // (ej: viáticos de una instalación). Si no, es un gasto general del negocio.
  budgetId    String?
  budget      Budget?  @relation(fields: [budgetId], references: [id], onDelete: SetNull)

  description String
  amount      Float
  currency    String   @default("ARS")
  date        DateTime @default(now())
  paymentMethod PaymentMethod? // reusa el mismo enum que ya usa Receipt
  notes       String?

  registeredByUserId String?
  registeredByUser   User? @relation(fields: [registeredByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([budgetId])
  @@index([categoryId])
}
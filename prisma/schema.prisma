generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* =========================
   ENUMS
========================= */

enum ProductCategory {
  biodigesters
  grease_traps
  maintenance
  other
}

enum BudgetStatus {
  draft
  sent
  approved
  rejected
  completed

  // Legacy state kept for backward compatibility; new updates should use current statuses.
  expired
}

enum ClientType {
  home
  home_modular
  cabin
  hall
  sanitary
  company
}

enum StockMovementType {
  in
  out
  adjust
}

enum UserRole {
  owner
  admin
  seller
  installer
  viewer
}

/* =========================
   TENANT
========================= */

model Tenant {
  id        String @id @default(uuid())

  name      String
  slug      String @unique

  email String?
  phone String?
  address String?
  website String?
  description String?

  logoUrl        String?
  faviconUrl     String?
  watermarkUrl   String?
  sidebarIconUrl String?
  primaryColor   String?
  secondaryColor String?
  accentColor    String?
  watermarkOpacity Float? @default(0.06)
  showPageNumbers  Boolean? @default(true)
  showWebsiteInPdf Boolean? @default(true)
  showFooterBranding Boolean? @default(false)
  preferredTheme  String? @default("system")

  customSellerLabel    String? @default("Vendedor")
  customInstallerLabel String? @default("Instalador")

  plan     String? @default("free")
  maxUsers Int?    @default(5)
  trialEndsAt DateTime?
  mpSubscriptionId String?

  active Boolean @default(true)

  
  budgetSequence Int @default(1)

  users          User[]
  clients        Client[]
  budgets        Budget[]
  sellers        Seller[]
  installers     Installer[]
  products       ProductService[]
  stockMovements StockMovement[]

  features Json? // { "calculator": bool, "commissions": bool, "vouchers": bool, "dashboardMetrics": bool, "stockAnalytics": bool }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  currency String @default("ARS") // 👈 moneda por defecto del tenant
}

/* =========================
   USERS
========================= */

model User {
  id        String   @id @default(uuid())

  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name      String
  email     String   @unique
  password  String?

  emailVerified DateTime?
  image         String?

  role      UserRole @default(viewer)
  active    Boolean @default(true)
  hasSeenOnboarding Boolean @default(false)   // 👈 nuevo

  accounts  Account[]
  sessions  Session[]
  seller    Seller?
  installer Installer?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

/* =========================
   NEXTAUTH
========================= */

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/* =========================
   CLIENTS
========================= */

model Client {
  id        String   @id @default(uuid())

  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Identidad
  name      String
  lastName  String?
  company   String?
  dni       String?
  cuit      String?

  // Contacto
  email     String?
  phone     String

  // Dirección
  address   String

  // Ubicación
  latitude  Float?
  longitude Float?
  city      String?
  province  String?

  // Uso
  type            ClientType?
  peopleCount     Int?
  usageFrequency  String?

  // Comercial
  status           String   @default("nuevo")
  notes            String   @default("")
  lastContactAt    DateTime?
  assignedSellerId String?
  locationUrl      String?

  // Relaciones
  budgets   Budget[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

/* =========================
   PRODUCTS / SERVICES
========================= */

model ProductService {
  id          String           @id @default(uuid())

  tenantId    String
  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  description String
  category    ProductCategory

  price       Float
  cost        Float?
  unit        String

  active      Boolean @default(true)

  stock       Int @default(0)

  items            BudgetItem[]
  stockMovements   StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  currency String @default("ARS") // 👈 moneda en la que está cargado el precio

  @@index([tenantId])
}

/* =========================
   BUDGETS
========================= */

model Budget {
  id        String @id @default(uuid())

  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  budgetNumber Int?

  clientId  String
  client    Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  items     BudgetItem[]
  history   BudgetStatusHistory[]

  status    BudgetStatus @default(draft)

  notes     String @default("")

  // Vendedor
  sellerId  String?
  seller    Seller? @relation(fields: [sellerId], references: [id], onDelete: SetNull)

  // Instalador
  installerId String?
  installer   Installer? @relation(fields: [installerId], references: [id], onDelete: SetNull)

  // Instalación
  installationResponsible String?
  installerReference      String?

  // Información adicional
  details Json?

  // Montos
  subtotal     Float
  discount     Float @default(0)
  tax          Float @default(0)
  shippingCost Float?
  total        Float

  // Comerciales
  paymentTerms String?
  validUntil   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  currency String @default("ARS") // 👈 moneda única de ESTE presupuesto
  revisionNumber Int @default(0) // 👈 nuevo — se incrementa en cada edición real (cambios en items)

  @@index([tenantId])
  @@index([clientId])
}

/* =========================
   INSTALLERS
========================= */

model Installer {
  id        String @id @default(uuid())

  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name      String
  lastName  String

  phone     String
  email     String?

  city      String?

  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  budgets   Budget[]

  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

/* =========================
   SELLERS
========================= */

model Seller {
  id        String @id @default(uuid())

  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name      String
  lastName  String

  dni       String?
  email     String?
  phone     String?

  address   String?
  city      String?
  province  String?

  sector    String?

  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  budgets   Budget[]

  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

/* =========================
   BUDGET ITEMS
========================= */

model BudgetItem {
  id               String @id @default(uuid())

  budgetId         String
  budget           Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  // 🌟 1. Lo hacemos opcional con "?" y le agregamos onDelete: SetNull
  productServiceId String?
  productService   ProductService? @relation(fields: [productServiceId], references: [id], onDelete: SetNull)

  // 🌟 2. Campo para cuando escriben un producto/servicio a medida que no existe en stock
  customName       String?

  quantity         Float

  unitPrice        Float

  discount         Float @default(0)

  subtotal         Float?

  widthCm          Float?
  heightCm         Float?
  hours            Float?
  calculatedM2     Float?
  depthCm          Float?
  direct           Float?
}

/* =========================
   BUDGET HISTORY
========================= */

model BudgetStatusHistory {
  id        String @id @default(uuid())

  budgetId  String
  budget    Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  from      BudgetStatus
  to        BudgetStatus

  changedAt DateTime @default(now())

  user      String?
}

/* =========================
   STOCK MOVEMENTS
========================= */

model StockMovement {
  id        String @id @default(cuid())

  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  productServiceId String
  productService   ProductService @relation(fields: [productServiceId], references: [id])

  delta     Int

  type      StockMovementType

  reason    String?

  createdAt DateTime @default(now())

  @@index([tenantId])
}